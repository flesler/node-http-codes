{
  "name": "http-codes",
  "version": "2.1.0",
  "description": "Map of HTTP status messages to codes based on Node's built-in (inverse) map",
  "keywords": [
    "http",
    "status",
    "codes",
    "messages",
    "builtin",
    "map",
    "javascript",
    "nodejs",
    "node"
  ],
  "author": {
    "name": "Ariel Flesler",
    "url": "https://github.com/flesler"
  },
  "license": "MIT",
  "homepage": "https://github.com/flesler/node-http-codes",
  "bugs": "https://github.com/flesler/node-http-codes/issues",
  "repository": "git://github.com/flesler/node-http-codes",
  "type": "module",
  "main": "./dist/http-codes.cjs",
  "module": "./dist/http-codes.js",
  "types": "./dist/http-codes.d.ts",
  "exports": {
    ".": {
      "types": "./dist/http-codes.d.ts",
      "import": "./dist/http-codes.js",
      "require": "./dist/http-codes.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate-types": "tsx bin/generate-types.ts",
    "build": "npm run generate-types && tsup",
    "test": "npm run test:types && npm run test:unit",
    "test:types:test": "tsc -p tsconfig.test.json --noEmit",
    "test:types:bin": "tsc -p bin/tsconfig.json --noEmit",
    "test:types": "npm run test:types:test && npm run test:types:bin",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "eslint --cache --cache-strategy content '{src,bin}/**/*.ts' '*.ts'",
    "lint:fix": "npm run lint -- --fix",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=14"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@stylistic/eslint-plugin": "^4.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.21.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
